# Copernicus Data Space Ecosystem — Sentinel Hub OAuth client.
# Create at https://dataspace.copernicus.eu → User Settings → OAuth clients.
# Without these the risk model runs weather-only and NDVI is simply absent.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# SmartFarm (my.smartfarm.com.tn) soil probe. Take the refresh token and user
# id from localStorage after logging in to the SmartFarm web app. Without
# these the soil-moisture panel on Sensors says so and shows nothing.
SMARTFARM_EMAIL=
SMARTFARM_UID=
SMARTFARM_REFRESH_TOKEN=
SMARTFARM_SENSOR=

# Farmers' fields (/api/lands). Vercel's disk is read-only, so in production
# fields are kept in Redis: Vercel dashboard → Storage → Marketplace →
# "Upstash for Redis" → connect to this project; it sets the two KV_ vars
# below. (UPSTASH_REDIS_REST_URL / _TOKEN from the Upstash console work too.)
# Without them, local development stores fields in data/lands.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=
