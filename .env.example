# Copernicus Data Space Ecosystem — Sentinel Hub OAuth client.
# Create at https://dataspace.copernicus.eu → User Settings → OAuth clients.
# Without these the risk model runs weather-only and NDVI is simply absent.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# SmartFarm (my.smartfarm.com.tn) soil probe. Take the refresh token and user
# id from localStorage after logging in to the SmartFarm web app. Without
# these the soil-moisture panel on Sensors says so and shows nothing.
SMARTFARM_EMAIL=
SMARTFARM_UID=
SMARTFARM_REFRESH_TOKEN=
SMARTFARM_SENSOR=
